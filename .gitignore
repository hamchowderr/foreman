# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# mastra build output
.mastra/

# workspace sandbox data
packages/agents/data/

# SDK integration test results
tests/sdk/results/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
*.db
*.db-journal
*.db-shm
*.db-wal

# playwright
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dolt database files (added by bd init)
.dolt/

# Zapier SDK/CLI update watcher state (per-machine throttle + notify watermark)
scripts/.zapier-sdk-watch.json
preview-auth.json

# Local dev-server logs (packages/agents/server-dev.log, packages/web/web-dev.log)
*-dev.log
.fallow/

# Agent skills: .claude/skills/ is the canonical (CC-read) copy and is tracked.
# .agents/skills/ is a byte-identical mirror written by the skills tool — ignore it
# so the same content isn't vendored twice. skills-lock.json is committed for provenance.
.agents/skills/

# Personal Claude Code local settings — machine-specific permission allowlist.
# The shared project config is .claude/settings.json (tracked); this one is per-machine.
.claude/settings.local.json

# Beads export (disposable; kept fresh via export.auto). Source of truth = Dolt DB. cp-uif3.1
.beads/issues.jsonl
.beads/dolt-backup.json
.beads/dolt-backup-state.json
