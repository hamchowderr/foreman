{
  "strict": true,
  "llm": {
    "fixtures": "./tests/fixtures/aimock"
  },
  "mcp": {
    "tools": [
      {
        "name": "list-connections",
        "description": "List the user's Zapier connections, optionally filtered by app or search text",
        "inputSchema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "description": "App key, e.g. gmail"
            },
            "search": {
              "type": "string",
              "description": "Search text"
            }
          }
        },
        "result": "{\"data\":[{\"id\":\"conn_gmail_1\",\"app\":\"GmailCLIAPI\",\"title\":\"Gmail (test@example.com)\"},{\"id\":\"conn_slack_1\",\"app\":\"SlackCLIAPI\",\"title\":\"Slack (Acme)\"}]}"
      },
      {
        "name": "list-actions",
        "description": "List the actions an app supports",
        "inputSchema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "description": "App key"
            },
            "actionType": {
              "type": "string",
              "description": "read, write, search, ..."
            }
          },
          "required": ["app"]
        },
        "result": "{\"data\":[{\"key\":\"message\",\"app\":\"GmailCLIAPI\",\"actionType\":\"write\",\"title\":\"Send Email\"}]}"
      },
      {
        "name": "get-action",
        "description": "Get one action's details",
        "inputSchema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "actionType": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          },
          "required": ["app", "actionType", "action"]
        },
        "result": "{\"data\":{\"key\":\"message\",\"app\":\"GmailCLIAPI\",\"actionType\":\"write\",\"title\":\"Send Email\"}}"
      },
      {
        "name": "list-action-input-field-choices",
        "description": "List the choices for one of an action's input fields",
        "inputSchema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "actionType": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "inputField": {
              "type": "string"
            },
            "connection": {
              "type": "string"
            }
          },
          "required": ["app", "actionType", "action", "inputField"]
        },
        "result": "{\"data\":[]}"
      },
      {
        "name": "run-action",
        "description": "Run a Zapier action (needs approval)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "actionType": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "connection": {
              "type": "string"
            },
            "inputs": {
              "type": "object",
              "description": "Action inputs"
            }
          },
          "required": ["app", "actionType", "action"]
        },
        "result": "{\"data\":[{\"id\":\"msg_mock_1\"}]}"
      },
      {
        "name": "fetch",
        "description": "Make an authenticated HTTP request through a Zapier connection",
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "init": {
              "type": "object"
            }
          },
          "required": ["url"]
        },
        "result": "{\"status\":200,\"body\":{}}"
      },
      {
        "name": "search_history",
        "description": "Search the user's past action history",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "userId": {
              "type": "string"
            },
            "topK": {
              "type": "number"
            }
          },
          "required": ["query", "userId"]
        },
        "result": "{\"results\":[]}"
      },
      {
        "name": "fork_conversation",
        "description": "Fork the current conversation into a new thread",
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "messageLimit": {
              "type": "number"
            }
          },
          "required": ["threadId"]
        },
        "result": "{\"newThreadId\":\"thread_forked_mock\",\"title\":\"Forked\",\"messagesCopied\":2,\"sourceThreadId\":\"thread_mock\"}"
      }
    ]
  },
  "a2a": {
    "agents": [
      {
        "name": "foreman",
        "description": "Primary orchestrator agent",
        "messages": [
          {
            "pattern": ".*",
            "parts": [
              {
                "text": "Foreman mock response."
              }
            ]
          }
        ]
      },
      {
        "name": "discovery",
        "description": "Tool and connection discovery agent",
        "messages": [
          {
            "pattern": ".*",
            "parts": [
              {
                "text": "Discovery mock response."
              }
            ]
          }
        ]
      },
      {
        "name": "execution",
        "description": "Action execution agent",
        "messages": [
          {
            "pattern": ".*",
            "parts": [
              {
                "text": "Execution mock response."
              }
            ]
          }
        ]
      },
      {
        "name": "history",
        "description": "Conversation history agent",
        "messages": [
          {
            "pattern": ".*",
            "parts": [
              {
                "text": "History mock response."
              }
            ]
          }
        ]
      },
      {
        "name": "supervisor",
        "description": "Agent supervision and routing",
        "messages": [
          {
            "pattern": ".*",
            "parts": [
              {
                "text": "Supervisor mock response."
              }
            ]
          }
        ]
      }
    ]
  }
}
