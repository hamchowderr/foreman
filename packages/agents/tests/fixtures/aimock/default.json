      "match": {
        "userMessage": "hello"
      },
      "response": {
        "content": "Hello! I'm Foreman, your AI automation assistant. I can help you connect apps, automate workflows, and execute actions through Zapier. What would you like to do?"
      }
    },
    {
      "match": {
        "userMessage": "help"
      },
      "response": {
        "content": "I can help you with:\n1. Discovering available app connections\n2. Listing and executing actions\n3. Setting up automations\n4. Managing your workflow history\n\nJust tell me what you'd like to accomplish!"
      }
    },
    {
      "match": {
        "userMessage": "connect",
        "sequenceIndex": 0
      },
      "response": {
        "toolCalls": [
          {
            "name": "list-connections",
            "arguments": {}
          }
        ]
      }
    },
    {
      "match": {
