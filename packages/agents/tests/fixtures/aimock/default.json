{
  "fixtures": [
    {
      "match": { "userMessage": "hello" },
      "response": {
        "content": "Hello! I'm Foreman, your AI automation assistant. I can help you connect apps, automate workflows, and execute actions through Zapier. What would you like to do?"
      }
    },
    {
      "match": { "userMessage": "help" },
      "response": {
        "content": "I can help you with:\n1. Discovering available app connections\n2. Listing and executing actions\n3. Setting up automations\n4. Managing your workflow history\n\nJust tell me what you'd like to accomplish!"
      }
    },
    {
      "match": { "userMessage": "connect", "sequenceIndex": 0 },
      "response": {
        "toolCalls": [
          {
            "name": "discover_connections",
            "arguments": { "query": "all" }
          }
        ]
      }
    },
    {
      "match": { "toolCallId": "call_discover" },
      "response": {
        "content": "I found several available connections. Which app would you like to connect?"
      }
    },
    {
      "match": { "userMessage": "send email", "sequenceIndex": 0 },
      "response": {
        "toolCalls": [
          {
            "name": "list_actions",
            "arguments": { "connectionId": "gmail" }
          }
        ]
      }
    },
    {
      "match": { "userMessage": "send email", "sequenceIndex": 1 },
      "response": {
        "toolCalls": [
          {
            "name": "execute_action",
            "arguments": {
              "actionId": "gmail_send_email",
              "params": {
                "to": "test@example.com",
                "subject": "Test",
                "body": "Hello from Foreman"
              }
            }
          }
        ]
      }
    },
    {
      "match": { "userMessage": "send email", "sequenceIndex": 2 },
      "response": {
        "content": "Done! I've sent the email via Gmail. Is there anything else you'd like me to do?"
      }
    }
  ]
