{
  "name": "@foreman/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "build:vercel": "DEPLOY_TARGET=vercel mastra build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare mastra build",
    "start": "node .mastra/output/index.mjs",
    "start:webhooks": "npx tsx src/webhook-server.ts",
    "dev:mock": "npx @copilotkit/aimock --config aimock.json --port 4010",
    "dev:telegram": "npx tsx src/telegram/start-polling.ts",
    "test": "vitest run --exclude tests/sdk/**",
    "test:sdk": "vitest run --config vitest.sdk.config.ts",
    "test:sdk:read": "vitest run --config vitest.sdk.config.ts -t 'SDK Read'",
    "test:sdk:write": "vitest run --config vitest.sdk.config.ts -t 'SDK Write'",
    "catalog:seed": "npx tsx scripts/seed-catalog.ts",
    "catalog:seed:quick": "npx tsx scripts/seed-catalog.ts --apps-only",
    "catalog:embed": "npx tsx scripts/seed-catalog.ts --embed-only"
  },
  "dependencies": {
    "@chat-adapter/discord": "^4.26.0",
    "@chat-adapter/gchat": "^4.26.0",
    "@chat-adapter/github": "^4.26.0",
    "@chat-adapter/linear": "^4.26.0",
    "@chat-adapter/slack": "^4.26.0",
    "@chat-adapter/state-memory": "^4.26.0",
    "@chat-adapter/teams": "^4.26.0",
    "@chat-adapter/telegram": "^4.26.0",
    "@chat-adapter/whatsapp": "^4.26.0",
    "@hono/node-server": "^1.19.14",
    "@mastra/ai-sdk": "^1.4.0",
    "@mastra/core": "^1.25.0",
    "@mastra/editor": "^0.7.16",
    "@mastra/evals": "^1.2.1",
    "@mastra/memory": "^1.15.1",
    "@mastra/observability": "^1.9.1",
    "@mastra/pg": "^1.9.1",
    "@mastra/rag": "^2.2.0",
    "@mastra/voice-openai": "^0.12.1",
    "@supabase/supabase-js": "^2.104.1",
    "@zapier/zapier-sdk": "^0.41.0",
    "ai": "^6.0.168",
    "chat": "^4.26.0",
    "chat-adapter-imessage": "^0.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@mastra/deployer-cloudflare": "^1.0.0",
    "@mastra/deployer-vercel": "^1.0.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.14.3",
    "@types/node": "^20",
    "@zapier/zapier-sdk-cli": "^0.39.9",
    "mastra": "1.6.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
