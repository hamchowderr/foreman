{
  "name": "@foreman/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "build:vercel": "DEPLOY_TARGET=vercel mastra build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare mastra build",
    "start": "node --env-file=.env.local .mastra/output/index.mjs 2>&1 | tee server.log",
    "start:webhooks": "npx tsx --env-file=.env.local src/webhook-server.ts",
    "dev:mock": "npx @copilotkit/aimock --config aimock.json --port 4010",
    "dev:telegram": "npx tsx --env-file=.env.local src/telegram/start-polling.ts",
    "test": "vitest run --exclude tests/sdk/** --exclude tests/live/**",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:sdk": "vitest run --config vitest.sdk.config.ts",
    "test:sdk:read": "vitest run --config vitest.sdk.config.ts -t 'SDK Read'",
    "test:sdk:write": "vitest run --config vitest.sdk.config.ts -t 'SDK Write'",
    "logs": "node scripts/show-logs.mjs",
    "logs:watch": "node scripts/show-logs.mjs watch",
    "catalog:seed": "npx tsx --env-file=.env.local scripts/seed-catalog.ts",
    "catalog:seed:quick": "npx tsx --env-file=.env.local scripts/seed-catalog.ts --apps-only",
    "catalog:embed": "npx tsx --env-file=.env.local scripts/seed-catalog.ts --embed-only",
    "datasets:smoke": "npx tsx --env-file=.env.local scripts/datasets-smoke.ts",
    "datasets:load-raw": "npx tsx --env-file=.env.local scripts/datasets-load-raw.ts",
    "datasets:label": "npx tsx --env-file=.env.local scripts/datasets-label.ts",
    "datasets:set-trajectory": "npx tsx --env-file=.env.local scripts/datasets-set-trajectory.ts",
    "datasets:fix-input": "npx tsx --env-file=.env.local scripts/datasets-fix-input.ts",
    "datasets:set-context": "npx tsx --env-file=.env.local scripts/datasets-set-context.ts",
    "datasets:mini-experiment": "npx tsx --env-file=.env.local scripts/datasets-mini-experiment.ts",
    "datasets:experiment": "npx tsx --env-file=.env.local scripts/datasets-experiment.ts"
  },
  "dependencies": {
    "@chat-adapter/discord": "^4.28.1",
    "@chat-adapter/gchat": "^4.28.1",
    "@chat-adapter/github": "^4.28.1",
    "@chat-adapter/linear": "^4.28.1",
    "@chat-adapter/slack": "^4.28.1",
    "@chat-adapter/state-memory": "^4.28.1",
    "@chat-adapter/teams": "^4.28.1",
    "@chat-adapter/telegram": "^4.28.1",
    "@chat-adapter/whatsapp": "^4.28.1",
    "@hono/node-server": "^1.19.14",
    "@mastra/ai-sdk": "^1.4.1",
    "@mastra/core": "^1.32.1",
    "@mastra/duckdb": "^1.3.0",
    "@mastra/editor": "^0.7.23",
    "@mastra/evals": "^1.2.2",
    "@mastra/loggers": "^1.1.1",
    "@mastra/memory": "^1.17.5",
    "@mastra/observability": "^1.11.1",
    "@mastra/pg": "^1.10.0",
    "@mastra/rag": "^2.2.1",
    "@mastra/voice-openai": "^0.12.1",
    "@supabase/supabase-js": "^2.105.4",
    "@zapier/zapier-sdk": "^0.48.0",
    "ai": "^6.0.177",
    "chat": "^4.28.1",
    "chat-adapter-imessage": "^0.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@mastra/deployer-cloudflare": "^1.1.32",
    "@mastra/deployer-vercel": "^1.1.26"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.14.3",
    "@types/node": "^20",
    "@zapier/zapier-sdk-cli": "^0.44.0",
    "mastra": "^1.8.1",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "zlib-sync": "^0.1.10"
  }
}
