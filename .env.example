# ─── Required ───

# LibSQL database URL (local file or Turso remote)
# For local development: file:./foreman.db
DATABASE_URL=file:./foreman.db

# 32-byte hex key for encrypting Zapier tokens at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_KEY_HERE

# ─── Optional (Phase 1 — local dev) ───

# Direct Zapier token for local development (bypasses OAuth flow)
# Obtain by running: npx zapier-sdk login
# DEV_ZAPIER_OVERRIDE=YOUR_ZAPIER_TOKEN_HERE

# ─── Optional (Phase 2+ — OAuth) ───

# Zapier OAuth credentials for production multi-user auth
# Create with: npx zapier-sdk create-client-credentials
# ZAPIER_CREDENTIALS=YOUR_ZAPIER_CREDENTIALS_HERE
# ZAPIER_CLIENT_ID=YOUR_ZAPIER_CLIENT_ID_HERE
# ZAPIER_CLIENT_SECRET=YOUR_ZAPIER_CLIENT_SECRET_HERE

# ─── Optional ───

# Application mode: "dev" (default) or "production"
# FOREMAN_MODE=dev
